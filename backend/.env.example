# Copy this file to .env and fill in your own key. NEVER commit .env.

# Required: get a key at https://console.groq.com/keys (sign in, "Create API Key").
# No credit card required to sign up. Usage for one interview session costs
# a tiny fraction of a cent (Groq charges per token, not a flat fee).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used to generate answers. openai/gpt-oss-120b (OpenAI's open-weight
# model, ~500 tok/s) tested well for this task. If you want to try a lighter/
# faster alternative, "openai/gpt-oss-20b" or "qwen/qwen3.8-27b" are also
# available on Groq's free-signup tier - run `npm run list-models` to see
# whatever is currently available on your account (Groq's lineup changes).
GROQ_MODEL=openai/gpt-oss-120b

# Port the local backend listens on. Must match extension Settings > Backend URL.
PORT=3001

# Optional: only needed if you want automatic tab-audio transcription (Beta).
# If left blank, the extension still works fully via microphone (Web Speech API)
# and manual question input - transcription is NOT required for the core app.
OPENAI_API_KEY=
